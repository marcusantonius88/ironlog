# IRONLOG Environment Configuration

# Database
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=password
DB_NAME=ironlog
DB_SSL_MODE=disable

# Kafka
KAFKA_BROKERS=localhost:9092
KAFKA_CONSUMER_GROUP=ironlog-services
KAFKA_PARTITIONS=3
KAFKA_REPLICATION_FACTOR=1

# Redis
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0

# Services
PARSER_SERVICE_PORT=8081
WORKOUT_SERVICE_PORT=8080
ANALYTICS_SERVICE_PORT=8082
PROJECTION_SERVICE_PORT=8083
RECOMMENDATION_SERVICE_PORT=8084
NOTIFICATION_SERVICE_PORT=8085

# Frontend
FRONTEND_PORT=3000
REACT_APP_API_URL=http://localhost:8080

# Observability
PROMETHEUS_PORT=9090
GRAFANA_PORT=3001
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=password
JAEGER_COLLECTOR_PORT=14250

# Logging
LOG_LEVEL=INFO

# Tracing
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:14250
OTEL_EXPORTER_OTLP_PROTOCOL=grpc

# Features
ENABLE_TRACING=true
ENABLE_METRICS=true
ENABLE_STRUCTURED_LOGGING=true
